# Copy this file to `.env.production` and fill in your machine's LAN IP.
# Used only by `npm run build:mobile` (the Capacitor native build) -- the
# regular web build/dev server don't need this (see services/api.ts and
# MOBILE.md). The native app has no same-origin backend, so it needs an
# absolute URL to a real, network-reachable backend.

# Find your Mac's LAN IP with `ipconfig getifaddr en0`, or on the Mac
# itself: System Settings -> Wi-Fi -> (i) next to your network -> IP
# Address. If your phone can't reach the backend, this is almost always why.
VITE_API_BASE_URL=http://YOUR_LAN_IP:8000/api
