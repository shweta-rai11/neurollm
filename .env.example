# Copy this file to .env and fill in values as needed. The app works fully
# without any of these being set -- it defaults to the offline MockProvider
# and a local SQLite database.

OPENAI_API_KEY=
# Leave OPENAI_API_KEY blank to run entirely offline via MockProvider (no
# key required, deterministic responses -- fine for local dev/demo).

OPENAI_MODEL=gpt-4o-mini
# OpenAI chat model to use when OPENAI_API_KEY is set.

BRAVE_SEARCH_API_KEY=
# Enables real retrieval-grounded fact-checking in the VERIFY pathway (see
# backend/app/retrieval/). Leave blank to fall back to self-critique-only
# verification (the original behavior) -- nothing breaks without this key,
# it just means the hallucination-risk refinement has one less real signal.

DEFAULT_MODEL=mock
# Model name used when a request doesn't specify one ("mock", "local_hf", or an OpenAI model name).

ENABLE_LOCAL_MODEL=1
# Offers "local_hf" (Qwen2.5-1.5B-Instruct, run on-device via Transformers) in
# /api/config's available_models. This is the only provider Research Mode can
# capture real activations from. First use downloads ~3GB of model weights
# and requires torch/transformers (see backend/requirements.txt) -- set to 0
# to hide it entirely (e.g. in constrained CI/demo environments).

DEFAULT_NUM_SAMPLES=5
# Default number of candidate responses sampled for uncertainty estimation.

MAX_NUM_SAMPLES=10
# Upper bound on the number of candidate responses a request may ask for.

DATABASE_URL=sqlite:///./ai_brain.db
# SQLAlchemy database URL. Defaults to a local SQLite file.

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost,https://localhost
# Comma-separated list of allowed CORS origins. The last three are the fixed
# origins Capacitor's native iOS/Android WebView always uses (see
# frontend/MOBILE.md) -- keep them if you're using the mobile app.

MAX_REQUEST_BODY_BYTES=65536
# Maximum allowed request body size in bytes (rejects larger requests with HTTP 413).

RATE_LIMIT_PER_MINUTE=60
# Max requests per minute per client IP (in-memory, per-process limiter).
